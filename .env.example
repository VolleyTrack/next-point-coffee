# Existing store / admin
NEXT_PUBLIC_STORE_LIVE=
# Public campaigns launch. Default off (unset/false). Set true only when Ryan approves launch.
NEXT_PUBLIC_CAMPAIGNS_LIVE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Same key as newsletter/orders admin. Also unlocks /campaigns preview while CAMPAIGNS_LIVE is false.
ADMIN_ACCESS_KEY=
# Optional override for campaigns preview unlock only. Falls back to ADMIN_ACCESS_KEY when unset.
CAMPAIGNS_PREVIEW_KEY=

# Existing Supabase REST (orders + newsletter). Optional for the campaigns prototype.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: POST each BooksEventEnvelope here (nextpoint-books receiver).
# When unset, events stay stubbed in this app.
BOOKS_WEBHOOK_URL=

# Optional shared secret with nextpoint-books.
# GET /api/books/export requires this key OR a Next Point Coffee admin session (athletes cannot pull).
BOOKS_API_KEY=

# Origin of the nextpoint-books Vercel deployment. Used only by next.config.js rewrites
# that proxy /admin/books (and /admin/books/:path*) to that host. Does not affect
# /admin/newsletter or /admin/orders. Rebuild after changing. Trailing slashes are stripped.
# Default: https://nextpoint-books.vercel.app
BOOKS_ORIGIN=

# Optional override for the local JSON ledger (defaults to data/campaigns-store.json).
CAMPAIGNS_DATA_PATH=

# Signs the partner portal session cookie. Falls back to ADMIN_ACCESS_KEY, then CAMPAIGNS_PREVIEW_KEY.
# Local dev with none of those set uses a built-in dev secret. Session cookie has no Max-Age (browser close)
# plus a 12-hour signed expiry.
PORTAL_SESSION_SECRET=

# Optional. Replaces the Next Point Coffee admin portal password on process start.
# Set this before flipping NEXT_PUBLIC_CAMPAIGNS_LIVE to true.
PORTAL_ADMIN_PASSWORD=

# Optional true/false. Default: README demo passwords work only while campaigns are not publicly live.
PORTAL_ALLOW_DEMO_PASSWORDS=

# Gmail SMTP already used for signup, contact, and campaign-request alerts.
# Partner temporary passwords are sent from GMAIL_USER to the club and athlete emails.
# Set GMAIL_USER to ryan@nextpointcoffee.com. NOTIFY_EMAIL is the internal alert inbox only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
